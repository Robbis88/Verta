# === Supabase ===
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service_role-nøkkel. KUN SERVER — eksponer aldri til nettleseren.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# === Site ===
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# === Anthropic (Claude) ===
# https://console.anthropic.com/settings/keys — kun server-side.
ANTHROPIC_API_KEY=sk-ant-...

# === Stripe (abonnement) ===
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_BASIS=price_...
STRIPE_PRICE_PLUSS=price_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_EXTRA_PROPERTY=price_...

# === Resend (transaksjons-e-post) ===
RESEND_API_KEY=re_...

# === Cron (Vercel) ===
# openssl rand -hex 32
CRON_SECRET=

# === Vipps ===
# OIDC (innlogging) + ePayment (boost-betaling). Fra Vipps-portalen.
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
# Bruk https://apitest.vipps.no i test, https://api.vipps.no i produksjon
VIPPS_API_BASE=https://api.vipps.no
# Sett "true" for å vise Vipps-innloggingsknappen (krever custom OIDC i Supabase)
NEXT_PUBLIC_VIPPS_ENABLED=false

# === Admin ===
# Komma-separert liste over e-poster med admin-tilgang (/admin)
ADMIN_EMAILS=

# === Smartlås (Premium) ===
# Seam-aggregator dekker Nuki, Igloohome og Salto via ett API.
# Sandbox-nøkkel (seam_test...) til utvikling; produksjonsnøkkel når live.
SEAM_API_KEY=seam_test_...
# Gammel direkte Nuki-token (utfases til fordel for Seam — dev-stub uten denne)
NUKI_API_TOKEN=

# NB: Auth bruker Supabase Auth (+ Vipps som custom OIDC-provider),
# IKKE NextAuth. Derfor ingen NEXTAUTH_*-variabler. Se IMPLEMENTATION_NOTES.md.
